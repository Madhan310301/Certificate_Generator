{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/certificate-generator dev",
    "build": "pnpm --filter @workspace/certificate-generator build && node scripts/copy-dist.mjs",
    "build:all": "pnpm run typecheck:all && pnpm -r --if-present run build",
    "preview": "pnpm --filter @workspace/certificate-generator serve",
    "serve": "pnpm --filter @workspace/certificate-generator serve",
    "typecheck": "pnpm --filter @workspace/certificate-generator typecheck",
    "typecheck:all": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:libs": "tsc --build"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
